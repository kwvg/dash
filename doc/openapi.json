{
  "openapi": "3.1.0",
  "info": {
    "title": "Dash Core REST API",
    "description": "Read-only REST interface to the Dash Core node. Every endpoint supports three wire formats selected by the URI extension: `.json`, `.hex`, `.bin`. Some endpoints (chaininfo, mempool) are JSON-only.",
    "version": "0.1.0",
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    }
  },
  "servers": [
    {
      "url": "http://127.0.0.1:9997",
      "description": "Mainnet (default port)"
    },
    {
      "url": "http://127.0.0.1:19997",
      "description": "Testnet (default port)"
    },
    {
      "url": "http://127.0.0.1:19897",
      "description": "Regtest (default port)"
    }
  ],
  "components": {
    "parameters": {
      "hash": {
        "name": "hash",
        "in": "path",
        "required": true,
        "description": "256-bit hex-encoded hash.",
        "schema": {
          "$ref": "#/components/schemas/hash256"
        }
      },
      "headerCount": {
        "name": "count",
        "in": "query",
        "required": false,
        "description": "Number of consecutive headers to return (1\u20132000, default 5).",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2000,
          "default": 5
        }
      },
      "filterType": {
        "name": "filtertype",
        "in": "path",
        "required": true,
        "description": "BIP 157 filter type name (e.g. `basic`).",
        "schema": {
          "type": "string",
          "enum": [
            "basic"
          ]
        }
      },
      "height": {
        "name": "height",
        "in": "path",
        "required": true,
        "description": "Non-negative block height.",
        "schema": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "schemas": {
      "hash256": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$",
        "description": "256-bit hex-encoded hash (64 characters, lowercase)."
      },
      "blockHeader": {
        "type": "object",
        "description": "Serialised block header (JSON representation).",
        "properties": {
          "hash": {
            "$ref": "#/components/schemas/hash256"
          },
          "confirmations": {
            "type": "integer"
          },
          "height": {
            "type": "integer"
          },
          "version": {
            "type": "integer"
          },
          "merkleroot": {
            "$ref": "#/components/schemas/hash256"
          },
          "time": {
            "type": "integer"
          },
          "nonce": {
            "type": "integer"
          },
          "bits": {
            "type": "string"
          },
          "difficulty": {
            "type": "number"
          },
          "chainwork": {
            "type": "string"
          },
          "previousblockhash": {
            "$ref": "#/components/schemas/hash256"
          },
          "nextblockhash": {
            "$ref": "#/components/schemas/hash256"
          },
          "chainlock": {
            "type": "boolean"
          }
        }
      },
      "block": {
        "description": "Full block with verbose transaction objects.",
        "allOf": [
          {
            "$ref": "#/components/schemas/blockHeader"
          },
          {
            "type": "object",
            "properties": {
              "tx": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              }
            }
          }
        ]
      },
      "blockNoTxDetails": {
        "description": "Block with transaction ids only (no full tx objects).",
        "allOf": [
          {
            "$ref": "#/components/schemas/blockHeader"
          },
          {
            "type": "object",
            "properties": {
              "tx": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/hash256"
                }
              }
            }
          }
        ]
      },
      "transaction": {
        "type": "object",
        "description": "Raw transaction in JSON form.",
        "properties": {
          "txid": {
            "$ref": "#/components/schemas/hash256"
          },
          "hash": {
            "$ref": "#/components/schemas/hash256"
          },
          "version": {
            "type": "integer"
          },
          "size": {
            "type": "integer"
          },
          "locktime": {
            "type": "integer"
          },
          "vin": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "vout": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "mempoolInfo": {
        "type": "object",
        "properties": {
          "loaded": {
            "type": "boolean"
          },
          "size": {
            "type": "integer"
          },
          "bytes": {
            "type": "integer"
          },
          "usage": {
            "type": "integer"
          },
          "total_fee": {
            "type": "number"
          },
          "maxmempool": {
            "type": "integer"
          },
          "mempoolminfee": {
            "type": "number"
          },
          "minrelaytxfee": {
            "type": "number"
          },
          "instantsendlocks": {
            "type": "integer"
          }
        }
      },
      "mempoolContents": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "description": "Per-transaction mempool entry, keyed by txid."
        }
      },
      "utxoResponse": {
        "type": "object",
        "properties": {
          "chainHeight": {
            "type": "integer"
          },
          "chaintipHash": {
            "$ref": "#/components/schemas/hash256"
          },
          "bitmap": {
            "type": "string",
            "description": "Bit string where each character corresponds to a queried outpoint (1 = unspent, 0 = spent)."
          },
          "utxos": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "height": {
                  "type": "integer"
                },
                "value": {
                  "type": "number"
                },
                "scriptPubKey": {
                  "type": "object"
                }
              }
            }
          }
        }
      },
      "blockFilter": {
        "type": "object",
        "properties": {
          "filter": {
            "type": "string",
            "description": "Hex-encoded BIP 158 compact block filter."
          }
        }
      },
      "blockHashByHeight": {
        "type": "object",
        "properties": {
          "blockhash": {
            "$ref": "#/components/schemas/hash256"
          }
        }
      },
      "chainInfo": {
        "type": "object",
        "description": "Identical to the `getblockchaininfo` RPC response.",
        "properties": {
          "chain": {
            "type": "string"
          },
          "blocks": {
            "type": "integer"
          },
          "headers": {
            "type": "integer"
          },
          "bestblockhash": {
            "$ref": "#/components/schemas/hash256"
          }
        }
      }
    },
    "responses": {
      "badRequest": {
        "description": "Malformed request (invalid hash, out-of-range parameter, etc.).",
        "content": {
          "text/plain": {
            "schema": {
              "type": "string"
            }
          }
        }
      },
      "notFound": {
        "description": "Requested resource was not found on the active chain.",
        "content": {
          "text/plain": {
            "schema": {
              "type": "string"
            }
          }
        }
      },
      "warmup": {
        "description": "Node is still starting up.",
        "content": {
          "text/plain": {
            "schema": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "paths": {
    "/rest/tx/{hash}.json": {
      "get": {
        "operationId": "getTxJson",
        "summary": "Look up a raw transaction by its txid.",
        "tags": [
          "Transactions"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/hash"
          }
        ],
        "responses": {
          "200": {
            "description": "Transaction found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/transaction"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/badRequest"
          },
          "404": {
            "$ref": "#/components/responses/notFound"
          },
          "503": {
            "$ref": "#/components/responses/warmup"
          }
        }
      }
    },
    "/rest/tx/{hash}.hex": {
      "get": {
        "operationId": "getTxHex",
        "summary": "Look up a raw transaction (hex-encoded).",

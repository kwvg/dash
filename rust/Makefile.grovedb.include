LIBRUST_GROVEDB_TARGET_DIR = $(abs_top_builddir)/rust/grovedb_cxx/target
LIBRUST_GROVEDB = $(LIBRUST_GROVEDB_TARGET_DIR)/$(RUST_TARGET)/$(CARGO_PROFILE)/libgrovedb_cxx.a

LIBRUST_GROVEDB_CARGO_ENV = $(CARGO_ENV) CARGO_TARGET_DIR="$(LIBRUST_GROVEDB_TARGET_DIR)"
LIBRUST_GROVEDB_CRATE_DIR = $(top_srcdir)/rust/grovedb_cxx
LIBRUST_GROVEDB_GEN_DIR = $(abs_top_builddir)/rust/grovedb_cxx/gen
LIBRUST_GROVEDB_GEN_SRCDIR = $(top_srcdir)/rust/grovedb_cxx/gen
LIBRUST_GROVEDB_MANIFEST = $(LIBRUST_GROVEDB_CRATE_DIR)/Cargo.toml
LIBRUST_GROVEDB_CARGO_BUILD_OPTS = $(CARGO_BUILD_OPTS) --manifest-path $(LIBRUST_GROVEDB_MANIFEST)

LIBRUST_GROVEDB_SRCS = \
	$(LIBRUST_GROVEDB_CRATE_DIR)/src/lib.rs

LIBRUST_GROVEDB_BUILD = \
	$(LIBRUST_GROVEDB_CRATE_DIR)/build.rs

LIBRUST_GROVEDB_CPP = \
	$(LIBRUST_GROVEDB_GEN_DIR)/src/lib.cpp

LIBRUST_GROVEDB_H = \
	$(LIBRUST_GROVEDB_GEN_DIR)/include/rust/grovedb_cxx/lib.h

LIBRUST_GROVEDB_INCLUDES = \
	-I$(LIBRUST_GROVEDB_GEN_DIR)/include

LIBRUST_GROVEDB_FILES = \
	$(LIBRUST_GROVEDB_BUILD) \
	$(LIBRUST_GROVEDB_MANIFEST) \
	$(LIBRUST_GROVEDB_SRCS)

$(LIBRUST_GROVEDB_SRCS): ;

$(LIBRUST_GROVEDB_CPP): $(LIBRUST_GROVEDB_SRCS)
	$(AM_V_at)$(MKDIR_P) $(@D)
	$(AM_V_GEN)if test -f $(LIBRUST_GROVEDB_GEN_SRCDIR)/src/lib.cpp && ! test $(LIBRUST_GROVEDB_GEN_SRCDIR)/src/lib.cpp -ef $@; then \
		cp $(LIBRUST_GROVEDB_GEN_SRCDIR)/src/lib.cpp $@; \
	elif ! test -f $@; then \
		$(CXXBRIDGE) $< -o $@; \
	fi

$(LIBRUST_GROVEDB_H): $(LIBRUST_GROVEDB_SRCS)
	$(AM_V_at)$(MKDIR_P) $(@D)
	$(AM_V_GEN)if test -f $(LIBRUST_GROVEDB_GEN_SRCDIR)/include/rust/grovedb_cxx/lib.h && ! test $(LIBRUST_GROVEDB_GEN_SRCDIR)/include/rust/grovedb_cxx/lib.h -ef $@; then \
		cp $(LIBRUST_GROVEDB_GEN_SRCDIR)/include/rust/grovedb_cxx/lib.h $@; \
	elif ! test -f $@; then \
		$(CXXBRIDGE) $< --header -o $@; \
	fi

$(LIBRUST_GROVEDB): $(LIBRUST_GROVEDB_SRCS) $(LIBRUST_GROVEDB_BUILD) $(LIBRUST_GROVEDB_MANIFEST)
	$(AM_V_GEN)$(LIBRUST_GROVEDB_CARGO_ENV) $(CARGO) build $(LIBRUST_GROVEDB_CARGO_BUILD_OPTS)

cargo-build-grovedb: $(LIBRUST_GROVEDB)

cargo-clean-grovedb:
	$(AM_V_at)rm -rf $(LIBRUST_GROVEDB_TARGET_DIR)

cxxbridge-clean-grovedb:
	$(AM_V_at)rm -rf $(LIBRUST_GROVEDB_GEN_DIR)

cxxbridge-grovedb: $(LIBRUST_GROVEDB_CPP) $(LIBRUST_GROVEDB_H)

dist-hook: cxxbridge-grovedb
	$(MKDIR_P) $(distdir)/grovedb_cxx/gen/src
	$(MKDIR_P) $(distdir)/grovedb_cxx/gen/include/rust/grovedb_cxx
	cp $(LIBRUST_GROVEDB_CPP) $(distdir)/grovedb_cxx/gen/src/
	cp $(LIBRUST_GROVEDB_H) $(distdir)/grovedb_cxx/gen/include/rust/grovedb_cxx/

.PHONY: cargo-build-grovedb cargo-clean-grovedb cxxbridge-grovedb cxxbridge-clean-grovedb

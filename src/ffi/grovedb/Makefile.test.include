TESTS = src/test/test_grovedb
noinst_PROGRAMS = src/test/test_grovedb

src_test_test_grovedb_SOURCES = \
	src/test/delete_tests.cpp \
	src/test/get_tests.cpp \
	src/test/insert_tests.cpp \
	src/test/lifecycle_tests.cpp \
	src/test/main.cpp \
	src/test/transaction_tests.cpp \
	src/test/util/tempdir.cpp \
	src/test/whoami.cpp

src_test_test_grovedb_CPPFLAGS = $(GROVEDB_CXX_CPPFLAGS) $(BOOST_CPPFLAGS)
src_test_test_grovedb_CPPFLAGS += \
	-I$(top_srcdir)/include \
	-I$(top_srcdir)/src \
	-I$(top_builddir)/src

src_test_test_grovedb_LDADD = libgrovedb.la $(GROVEDB_CXX_LIBS)

src_test_test_grovedb_LDFLAGS = -static
